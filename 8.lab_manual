//Write a program that finds if a given number is a prime number
#include<stdio.h>
void main()
{
    printf("\t\t\t\tPRIME NUMBER\n");
    int num, temp=0;
    printf("Enter a number to check whether it is prime or not: ");
    scanf("%d", &num);

    if(num==0 || num==1)
    {
        temp=1;
    }

    for(int i=2;i<=num/2;++i)
    {
        if(num%i==0)
        {
            temp=1;
            break;   
        }
    }
    if(temp==0)
    {
        printf("%d is a prime number\n", num);
    }
    else
    {
     printf("%d is not a prime number\n", num);
    }
}
